# Compose Manager route: save as .env next to compose.yaml and fill in.
PUBLIC_URL=https://talk.example.com
# openssl rand -hex 32  (use a different value for each)
JWT_SECRET=
POSTGRES_PASSWORD=
S3_SECRET_KEY=
# Used once, on the first start, to create the admin account.
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=
# Optional
MNEMA_APPDATA=/mnt/user/appdata/mnema-talk
PORT=8080
INITIAL_LANGUAGE=en
# Address of your reverse proxy container, e.g. 172.17.0.5 (never a whole range).
TRUSTED_PROXY_CIDRS=
# Your public IP or DynamicDNS name when voice does not connect from outside.
WEBRTC_NAT_1TO1_IP=
